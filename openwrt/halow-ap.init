#!/bin/sh /etc/rc.common
# Procd init script for the HaLow AP.
# respawn 3600 1 0 matches OpenWrt's own hostapd init so that a daemonised
# hostapd_s1g is not misclassified as a crash loop.

START=95
STOP=10
USE_PROCD=1

START_SCRIPT="/usr/share/halow/start-ap.sh"
STOP_SCRIPT="/usr/share/halow/stop-ap.sh"

start_service() {
    if [ ! -x "$START_SCRIPT" ]; then
        echo "$START_SCRIPT not found or not executable."
        exit 2
    fi
    procd_open_instance
    procd_set_param command /bin/sh -c "$START_SCRIPT && sleep infinity"
    procd_set_param respawn 3600 1 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    if [ -x "$STOP_SCRIPT" ]; then
        /bin/sh "$STOP_SCRIPT"
    fi
}
