#!/bin/sh /etc/rc.common
# Procd init script.  start-ap.sh execs hostapd_s1g, so procd tracks
# the real daemon.
# respawn 3600 5 5: after 5 rapid restarts within an hour procd stops
# the service.  This makes a permanent config error (start-ap.sh exit 5)
# visible in logread instead of restarting forever.

# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

START_SCRIPT="/usr/share/halow/start-ap.sh"
STOP_SCRIPT="/usr/share/halow/stop-ap.sh"

start_service() {
    [ -x "$START_SCRIPT" ] || { echo "$START_SCRIPT missing"; exit 2; }
    procd_open_instance
    procd_set_param command /bin/sh "$START_SCRIPT"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    [ -x "$STOP_SCRIPT" ] && /bin/sh "$STOP_SCRIPT"
}
