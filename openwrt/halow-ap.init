#!/bin/sh /etc/rc.common
# Procd init script for the HaLow AP.
# START, STOP, and USE_PROCD are read by rc.common, not by this script.
# shellcheck disable=SC2034
START=95
# shellcheck disable=SC2034
STOP=10
# shellcheck disable=SC2034
USE_PROCD=1

START_SCRIPT="/usr/share/halow/start-ap.sh"
STOP_SCRIPT="/usr/share/halow/stop-ap.sh"

start_service() {
    if [ ! -x "$START_SCRIPT" ]; then
        echo "$START_SCRIPT not found or not executable."
        exit 2
    fi
    procd_open_instance
    # hostapd_s1g daemonises with -B.  Wrap the script in a long-lived
    # process so procd tracks something that stays alive, avoiding a
    # false crash-loop classification.
    procd_set_param command /bin/sh -c "$START_SCRIPT; exec sleep infinity"
    procd_set_param respawn 3600 1 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    if [ -x "$STOP_SCRIPT" ]; then
        /bin/sh "$STOP_SCRIPT"
    fi
    killall -q hostapd_s1g
}
