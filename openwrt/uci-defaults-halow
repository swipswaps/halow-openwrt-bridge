#!/bin/sh
# First-boot seed for HaLow.  Copy to /etc/uci-defaults/99-halow.
# procd executes this once and deletes it on success.

HALOW_IF=wlan0

for radio_section in $(uci show wireless 2>&1 | awk -F. '/\.radio[0-9]+=/ {print $2}'); do
    uci set "wireless.$radio_section.disabled='1'"
done

if uci get network.@device[-1] >/dev/null 2>&1; then
    uci add_list network.@device[-1].ports="$HALOW_IF"
fi

uci add_list firewall.@zone[0].network="$HALOW_IF"

uci commit wireless
uci commit network
uci commit firewall

exit 0
